    "start": "bun run src/cli.tsx"
  },
  "dependencies": {
    "ink": "^5.1.0",
    "ink-select-input": "^6.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "bun-types": "^1.4.2",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
