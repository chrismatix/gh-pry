{
  "name": "gh-pry",
  "version": "0.1.0",
  "description": "Pry open a single GitHub PR in the terminal — threads, checks, replies, merge, CI logs — and open its diff in hunk",
  "license": "MIT",
  "type": "module",
  "bin": {
    "gh-pry": "gh-pry"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
